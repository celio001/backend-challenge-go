# Local development values only. Copy to .env to override the defaults used by docker-compose.yaml.
# Every variable is optional: compose falls back to the value shown here.

# Superuser of the Postgres container (used only by db-init and for administration)
POSTGRES_PASSWORD=postgres
# Host port mapped to the Postgres container
POSTGRES_PORT=5432

# wallet_owner owns the tables and runs migrations; wallet_app is what the replicas connect as
WALLET_OWNER_PASSWORD=wallet_owner
WALLET_APP_PASSWORD=wallet_app

# Keycloak bootstrap admin (the admin console is on http://localhost:8080)
KEYCLOAK_ADMIN_PASSWORD=admin

# Read by the service itself (set in docker-compose.yaml; export them to run `go run ./cmd/wallet-service` on the host)
# HTTP_ADDR=:8081
# DATABASE_URL=postgres://wallet_app:wallet_app@localhost:5432/challenge?sslmode=disable
# OIDC_ISSUER=http://localhost:8080/realms/wallet
# OIDC_DISCOVERY_URL=
# OIDC_AUDIENCE=wallet-api
# REFERENCE_TTL=10m
# REFERENCE_LEASE=30s
# OUTBOX_LEASE=30s
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=test
# AWS_SECRET_ACCESS_KEY=test
# SQS_ENDPOINT=http://localhost:4566
# EVENTS_QUEUE_NAME=wallet-events.fifo
# EVENTS_QUEUE_URL=
# WAGER_QUEUE_NAME=wager-transactions.fifo
# WAGER_QUEUE_URL=
# WAGER_DLQ_NAME=wager-transactions-dlq.fifo
# WAGER_DLQ_URL=
# senderId=providerId[,senderId=providerId]; LocalStack reports 000000000000 for every sender
# SQS_SENDER_PROVIDER_MAP=000000000000=provider-a

# Tracing (OpenTelemetry) is off unless an OTLP endpoint is set; the standard OTEL_* variables configure the rest
# (https://opentelemetry.io/docs/languages/sdk-configuration/). `make up-tracing` sets the endpoint for the Compose stack.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=wallet-service
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=0.1
# OTEL_SDK_DISABLED=true

# Read by the integration and recovery tests (make test-integration, make test-recovery)
# A superuser connection: each test creates (and drops) its own database from it
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres?sslmode=disable
# TEST_KEYCLOAK_URL=http://localhost:8080
# TEST_SQS_ENDPOINT=http://localhost:4566
